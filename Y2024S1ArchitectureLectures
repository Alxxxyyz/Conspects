    r2 = 30;
    $display("t=%0t: Set r2 to %0d", $time, r2);
    #10 r2 = 31;
    $display("t=%0t: Set r2 to %0d", $time, r2);
    #5 r2 = 32;
    $display("t=%0t: Set r2 to %0d", $time, r2);
